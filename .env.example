# Local development without Docker (each app reads this file).
PORT_API=3007
PORT_BATCH=3008

# Every microservice connects to this server but uses its own database
# (nestar_member, nestar_property, nestar_community, nestar_social).
MONGO_DEV=mongodb://127.0.0.1:27017/nestar
MONGO_PROD=

# Shared by api-gateway (verifies JWTs) and member-service (signs JWTs).
SECRET_TOKEN=change-me

# Microservice addresses (defaults shown). Ports: member 4001, property 4002, community 4003, social 4004, ai 4005.
# MEMBER_SERVICE_HOST=127.0.0.1
# MEMBER_SERVICE_PORT=4001

# AI assistant (Ollama running on this computer: https://ollama.com, then `ollama pull llama3.2`)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
